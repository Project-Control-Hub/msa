# =============================================================================
# PCH MSA — Production Environment Variables Example
# Copy this file to .env and fill in all values marked with CHANGE_ME
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Image Registry
# -----------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io
# GitHub owner/repo, e.g. myorg/pch-msa
IMAGE_REPO=CHANGE_ME/pch-msa
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_USER=pchuser
MYSQL_PASSWORD=CHANGE_ME_db_password
MYSQL_HOST_PORT=3306

# Per-service database names (must match init-db.sql)
AUTH_DB_NAME=pch_auth
PROJECT_DB_NAME=pch_project
ISSUE_DB_NAME=pch_issue
BOARD_REPORT_DB_NAME=pch_board_report
NOTIFICATION_DB_NAME=pch_notification
INTEGRATION_DB_NAME=pch_integration

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_MAX_MEMORY=256mb
REDIS_HOST_PORT=6379

# Redis database index allocation per service
GATEWAY_REDIS_DB=0
AUTH_REDIS_DB=1
ISSUE_REDIS_DB=2
BOARD_REPORT_REDIS_DB=3
NOTIFICATION_REDIS_DB=4
INTEGRATION_REDIS_DB=5

# -----------------------------------------------------------------------------
# Kafka (KRaft mode)
# -----------------------------------------------------------------------------
# Must be a valid base64url-encoded 22-char UUID — generate with:
#   docker run --rm confluentinc/cp-kafka:7.7.1 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_HOST_PORT=29092

# Kafka consumer group IDs
PROJECT_KAFKA_GROUP_ID=pch-project-group
ISSUE_KAFKA_GROUP_ID=pch-issue-group
BOARD_REPORT_KAFKA_GROUP_ID=pch-board-report-group
SEARCH_KAFKA_GROUP_ID=pch-search-group
NOTIFICATION_KAFKA_GROUP_ID=pch-notification-group
FILE_KAFKA_GROUP_ID=pch-file-group
INTEGRATION_KAFKA_GROUP_ID=pch-integration-group

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ES_JAVA_OPTS=-Xms512m -Xmx512m
ES_HOST_PORT=9200

# -----------------------------------------------------------------------------
# AWS S3 (pch-file-service)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=CHANGE_ME-pch-files

# -----------------------------------------------------------------------------
# JWT (pch-auth-service)
# -----------------------------------------------------------------------------
# Minimum 32 characters, randomly generated
JWT_SECRET=CHANGE_ME_at_least_32_chars_random_secret_here
# Token TTL in milliseconds
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# -----------------------------------------------------------------------------
# Monitoring — Prometheus
# -----------------------------------------------------------------------------
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=15d

# -----------------------------------------------------------------------------
# Monitoring — Grafana
# -----------------------------------------------------------------------------
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
GRAFANA_ROOT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Service host ports (override if defaults conflict on your host)
# -----------------------------------------------------------------------------
DISCOVERY_HOST_PORT=8761
GATEWAY_HOST_PORT=8000
AUTH_HOST_PORT=8081
PROJECT_HOST_PORT=8082
ISSUE_HOST_PORT=8083
BOARD_REPORT_HOST_PORT=8084
SEARCH_HOST_PORT=8085
NOTIFICATION_HOST_PORT=8086
FILE_HOST_PORT=8087
INTEGRATION_HOST_PORT=8088
