# ============================================================
#  PCH MSA - Local Development Environment Variables
#  Copy this file to `.env` and adjust as needed.
# ============================================================

# ─── MySQL ───
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka ───
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Elasticsearch ───
ELASTICSEARCH_URIS=http://elasticsearch:9200

# ─── Eureka ───
EUREKA_URI=http://discovery:8761/eureka

# ─── JWT ───
JWT_SECRET=dev-secret-key-must-be-at-least-32-characters-long-change-me-in-prod
JWT_ACCESS_EXP=1800
JWT_REFRESH_EXP=1209600

# ─── CORS ───
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Integrations (optional) ───
GITHUB_WEBHOOK_SECRET=change-me
SLACK_WEBHOOK_URL=

# ─── S3 (optional, Phase 1 file service) ───
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=pch-dev-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── SMTP (optional, notifications) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Monitoring ───
GRAFANA_ADMIN_PASSWORD=admin
